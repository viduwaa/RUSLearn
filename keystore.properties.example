# Copy this file to keystore.properties (kept in the repo root, NEVER committed)
# and fill it with your release-keystore values.
#
# One-time keystore creation (choose/keep a strong password; EVERY release uses it):
#   keytool -genkeypair -v -keystore ruslearn-release.jks -alias ruslearn -keyalg RSA -keysize 2048 -validity 10000
#
# The generated ruslearn-release.jks should stay next to this file (default below = ../).
storeFile=../ruslearn-release.jks
storePassword=CHANGE_ME
keyAlias=ruslearn
keyPassword=CHANGE_ME
