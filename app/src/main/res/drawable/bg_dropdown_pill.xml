<?xml version="1.0" encoding="utf-8"?>
<!-- Clean dropdown pill (ticket 07): faculty-faint fill, hairline stroke, chevron
     space on the end. Matches the .ddown twin in preview.html. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/colorFacultyContainer" />
            <stroke android:width="1dp" android:color="@color/colorHairline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:gravity="end|center_vertical" android:width="24dp" android:height="24dp">
        <vector android:width="24dp" android:height="24dp"
            android:viewportWidth="24" android:viewportHeight="24">
            <path android:fillColor="@color/colorFaculty"
                android:pathData="M7,10l5,5 5,-5z" />
        </vector>
    </item>
</layer-list>
