<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPaper"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/colorPaper">

    <include android:id="@+id/toolbarInclude" layout="@layout/view_toolbar" />

    <LinearLayout
        android:id="@+id/programRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarInclude">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gpa_program"
            android:textAppearance="@style/TextAppearance.RUSLearn.Label"
            android:textColor="@color/colorInk" />

        <Spinner
            android:id="@+id/spProgram"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/overallCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/programRow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gpa_saved_label"
                    android:textAppearance="@style/TextAppearance.RUSLearn.Label"
                    android:textColor="@color/colorInkMuted" />

                <TextView
                    android:id="@+id/tvSavedGpa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RUSLearn.Display"
                    android:textColor="@color/colorInk" />

                <TextView
                    android:id="@+id/tvSavedBand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RUSLearn.Code"
                    android:textColor="@color/colorInkMuted" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gpa_current_label"
                    android:textAppearance="@style/TextAppearance.RUSLearn.Label"
                    android:textColor="@color/colorInkMuted" />

                <TextView
                    android:id="@+id/tvCurrentGpa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RUSLearn.Display"
                    android:textColor="@color/colorInk" />

                <TextView
                    android:id="@+id/tvCurrentBand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RUSLearn.Code"
                    android:textColor="@color/colorInkMuted" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvCreditsProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.RUSLearn.Code"
            android:textColor="@color/colorInk" />

        <ProgressBar
            android:id="@+id/pbCredits"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:max="120"
            android:progressTint="@color/colorFaculty"
            android:secondaryProgressTint="@color/colorHairline" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/semesterRow"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/overallCard">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gpa_semester"
            android:textAppearance="@style/TextAppearance.RUSLearn.Label"
            android:textColor="@color/colorInk" />

        <Spinner
            android:id="@+id/spSemester"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvSemesterGpa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textAppearance="@style/TextAppearance.RUSLearn.Code"
            android:textColor="@color/colorFaculty"
            android:textStyle="bold" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvSubjects"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:divider="@color/colorHairline"
        android:dividerHeight="1dp"
        app:layout_constraintBottom_toTopOf="@id/btnSaveGrades"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/semesterRow" />

    <Button
        android:id="@+id/btnSaveGrades"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:text="@string/gpa_save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>

