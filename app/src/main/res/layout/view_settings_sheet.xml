<?xml version="1.0" encoding="utf-8"?>
<!-- Settings sheet (ticket 02b): the six actions as a ListView — the same
     row-click mechanism as the app's paper lists, so a tap anywhere on a row
     is one framework-handled touch target. Card stock wraps the list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ListView
        android:id="@+id/lvSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="?attr/selectableItemBackground"
        android:scrollbars="none" />
</LinearLayout>
