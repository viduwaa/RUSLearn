<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPaper"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <TextView
            android:id="@+id/requestIntro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/request_intro"
            android:textAppearance="@style/TextAppearance.RUSLearn.Body"
            android:textColor="@color/colorInkMuted"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/etRequest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_field"
            android:gravity="top"
            android:hint="@string/request_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:lines="5"
            android:maxLines="8"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.RUSLearn.Body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/requestIntro" />

        <TextView
            android:id="@+id/tvRequestCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textAppearance="@style/TextAppearance.RUSLearn.Code"
            android:textColor="@color/colorInkMuted"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etRequest" />

        <Button
            android:id="@+id/btnSubmitRequest"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/request_submit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRequestCounter" />

        <TextView
            android:id="@+id/tvRequestError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.RUSLearn.Body"
            android:textColor="@color/colorError"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnSubmitRequest" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
