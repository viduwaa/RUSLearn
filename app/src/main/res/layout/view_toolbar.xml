<?xml version="1.0" encoding="utf-8"?>
<!-- Screen header include (audit S4): serif title on paper, hairline rule beneath.
     Activities call ToolbarActivity.bindToolbar(...); stacked pages add the up arrow. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar.RUSLearn"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:titleTextAppearance="@style/TextAppearance.RUSLearn.Title" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorHairline" />
</LinearLayout>
