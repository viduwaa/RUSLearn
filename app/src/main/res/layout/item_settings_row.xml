<?xml version="1.0" encoding="utf-8"?>
<!-- One settings action: icon square + title + mono caption. The ListView owns
     the touch; children are never clickable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/ivRowIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_icon_square"
        android:contentDescription="@null"
        android:padding="7dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.RUSLearn.Body"
            android:textColor="@color/colorInk" />

        <TextView
            android:id="@+id/tvRowCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textAppearance="@style/TextAppearance.RUSLearn.Code"
            android:textSize="10sp"
            android:textColor="@color/colorInkMuted" />
    </LinearLayout>
</LinearLayout>
