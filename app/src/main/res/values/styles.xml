<?xml version="1.0" encoding="utf-8"?>
<!-- Shared "Paper & Ink" vocabulary: textAppearances + component styles.
     Layouts reference these; per-view hex tints are retired by the screen tickets. -->
<resources>

    <!-- ===== Type — IBM Plex via @font/plex_*.xml families ===== -->

    <style name="TextAppearance.RUSLearn.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/plex_serif</item>
        <item name="fontFamily">@font/plex_serif</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.RUSLearn.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/plex_serif</item>
        <item name="fontFamily">@font/plex_serif</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.RUSLearn.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/plex_sans</item>
        <item name="fontFamily">@font/plex_sans</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.RUSLearn.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/plex_sans</item>
        <item name="fontFamily">@font/plex_sans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.RUSLearn.Code" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/plex_mono</item>
        <item name="fontFamily">@font/plex_mono</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <!-- ===== Shape ===== -->

    <style name="Shape.RUSLearn.Card" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Shape.RUSLearn.Button" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- ===== Toolbar (ticket 02: title + up-nav on every sub-screen) ===== -->

    <style name="Toolbar.RUSLearn" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/colorPaper</item>
        <item name="titleTextAppearance">@style/TextAppearance.RUSLearn.Title</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.RUSLearn.Code</item>
        <item name="titleTextColor">@color/colorInk</item>
        <item name="navigationIconTint">@color/colorInk</item>
    </style>

    <!-- ===== Card ===== -->

    <style name="Card.RUSLearn" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/colorCard</item>
        <item name="strokeColor">@color/colorHairline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- ===== Buttons (spec §3.5): Filled / Tonal / Outlined / Text ===== -->

    <style name="Button.RUSLearn" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/TextAppearance.RUSLearn.Label</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="shapeAppearance">@style/Shape.RUSLearn.Button</item>
    </style>

    <style name="Button.RUSLearn.Filled">
        <item name="backgroundTint">@color/colorFaculty</item>
        <item name="android:textColor">@color/colorOnFaculty</item>
        <item name="iconTint">@color/colorOnFaculty</item>
    </style>

    <style name="Button.RUSLearn.Tonal">
        <item name="backgroundTint">@color/colorFacultyContainer</item>
        <item name="android:textColor">@color/colorFaculty</item>
        <item name="iconTint">@color/colorFaculty</item>
    </style>

    <style name="Button.RUSLearn.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAppearance">@style/TextAppearance.RUSLearn.Label</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="shapeAppearance">@style/Shape.RUSLearn.Button</item>
        <item name="strokeColor">@color/colorHairline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/colorInk</item>
        <item name="iconTint">@color/colorInk</item>
    </style>

    <style name="Button.RUSLearn.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.RUSLearn.Label</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/colorFaculty</item>
        <item name="iconTint">@color/colorFaculty</item>
    </style>

    <!-- ===== Exposed dropdown (spec §3.5: Dropdown.RUSLearn) ===== -->

    <style name="Dropdown.RUSLearn" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/colorHairline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxBackgroundColor">@color/colorCard</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="android:textColorHint">@color/colorInkMuted</item>
        <item name="hintTextColor">@color/colorFaculty</item>
    </style>

    <!-- ===== Chips (spec §3.5: Chip.RUSLearn.Filter) ===== -->

    <style name="Chip.RUSLearn" parent="Widget.Material3.Chip.Assist">
        <item name="android:textAppearance">@style/TextAppearance.RUSLearn.Code</item>
        <item name="chipBackgroundColor">@color/colorFacultyContainer</item>
        <item name="chipStrokeColor">@color/colorHairline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/colorFaculty</item>
        <item name="closeIconTint">@color/colorFaculty</item>
    </style>

    <style name="Chip.RUSLearn.Filter">
        <item name="closeIconVisible">true</item>
    </style>
</resources>
